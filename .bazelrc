build --cxxopt="-std=c++20"
build --host_cxxopt="-std=c++20"
build --action_env=BAZEL_CXXOPTS="-std=c++20"

test --nocache_test_results
test --test_output=errors

test --local_test_jobs=auto
test --test_timeout=30

startup --batch
startup --host_jvm_args=-Djdk.tls.client.protocols=TLSv1.2

common --registry=https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main/
common --registry=https://registry.bazel.build/

build:clangd --cxxopt="-std=c++20"
build:clangd --host_cxxopt="-std=c++20"
build:clangd --compilation_mode=dbg
build:clangd --copt="-g"
build:clangd --cxxopt="-g"
build:clangd --features=debug_prefix_map_pwd_is_dot

coverage --combined_report=lcov
coverage --coverage_report_generator=@bazel_tools//tools/test/CoverageOutputGenerator/java/com/google/devtools/coverageoutputgenerator:Main

# Required for bazel_clang_tidy to operate as expected
build:clang-tidy --aspects @bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=report

# Optionally override the .clang-tidy config file target
build:clang-tidy --@bazel_clang_tidy//:clang_tidy_config=@//:clang_tidy_config

build:clang-tidy --verbose_failures
build:clang-tidy --keep_going

# Cland-format
common --registry=https://raw.githubusercontent.com/digiboys/bazel-registry/main
common --registry=https://bcr.bazel.build

build:clang-format --@bazel_clang_format//:config=//:clang_format_config
build:clang-format-fix --@bazel_clang_format//:config=//:clang_format_config

build:clang-format --aspects=@bazel_clang_format//:defs.bzl%check_aspect
build:clang-format --output_groups=report

build:clang-format-fix --aspects=@bazel_clang_format//:defs.bzl%fix_aspect
build:clang-format-fix --output_groups=report
build:clang-format-fix --use_action_cache=false

build:clang-format --keep_going